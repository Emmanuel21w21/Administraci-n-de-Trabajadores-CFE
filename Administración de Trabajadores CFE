<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Reto 3: Sistema de Credencialización Web (CFE)</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- QRCode Generator Library -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>
    <style>
        @media print {
            .no-print { display: none !important; }
            body { background: white !important; }
        }
    </style>
</head>
<body class="bg-emerald-50/40 text-slate-800 font-sans antialiased">

    <!-- Toast Notification Container -->
    <div id="toast-container" class="fixed bottom-5 right-5 z-50 flex flex-col space-y-2 pointer-events-none"></div>

    <div class="min-h-screen flex flex-col md:flex-row">

        <!-- Sidebar / Navigation -->
        <aside class="bg-emerald-950 text-white w-full md:w-64 p-6 flex flex-col justify-between shadow-xl no-print border-r border-emerald-900">
            <div>
                <div class="flex items-center space-x-3 mb-8">
                    <div class="bg-emerald-600 p-2.5 rounded-xl shadow-md">
                        <i class="fa-solid fa-id-card text-xl text-white"></i>
                    </div>
                    <div>
                        <h1 class="text-base font-bold tracking-wide">CredencialWeb</h1>
                        <p class="text-[10px] text-emerald-300">Sistema CFE - Reto 3</p>
                    </div>
                </div>

                <nav class="space-y-1.5">
                    <button onclick="switchTab('trabajadores')" id="nav-trabajadores" class="w-full flex items-center space-x-3 py-2.5 px-4 rounded-xl bg-emerald-700 text-white shadow-lg shadow-emerald-900/40 transition text-sm font-semibold">
                        <i class="fa-solid fa-users w-5"></i>
                        <span>Trabajadores</span>
                    </button>
                    <button onclick="switchTab('credenciales')" id="nav-credenciales" class="w-full flex items-center space-x-3 py-2.5 px-4 rounded-xl text-emerald-100 hover:bg-emerald-900 transition text-sm font-medium">
                        <i class="fa-solid fa-address-card w-5"></i>
                        <span>Credenciales</span>
                    </button>
                    <button onclick="switchTab('escaner')" id="nav-escaner" class="w-full flex items-center space-x-3 py-2.5 px-4 rounded-xl text-emerald-100 hover:bg-emerald-900 transition text-sm font-medium">
                        <i class="fa-solid fa-qrcode w-5"></i>
                        <span>Escáner QR / Público</span>
                    </button>
                    <button onclick="switchTab('notificaciones')" id="nav-notificaciones" class="w-full flex items-center space-x-3 py-2.5 px-4 rounded-xl text-emerald-100 hover:bg-emerald-900 transition text-sm font-medium">
                        <i class="fa-solid fa-envelope-circle-check w-5"></i>
                        <span>Notificaciones Correo</span>
                    </button>
                    <button onclick="switchTab('reportes')" id="nav-reportes" class="w-full flex items-center space-x-3 py-2.5 px-4 rounded-xl text-emerald-100 hover:bg-emerald-900 transition text-sm font-medium">
                        <i class="fa-solid fa-chart-pie w-5"></i>
                        <span>Reportes</span>
                    </button>
                </nav>
            </div>

            <div class="pt-6 border-t border-emerald-900 space-y-3">
                <div class="flex items-center space-x-3 bg-emerald-900/60 p-3 rounded-xl border border-emerald-800">
                    <div class="w-2.5 h-2.5 rounded-full bg-emerald-400 animate-pulse"></div>
                    <div class="text-xs">
                        <p class="font-bold text-white">Admin Autorizado</p>
                        <p class="text-[10px] text-emerald-300">Protección CFE Activa</p>
                    </div>
                </div>
                <button onclick="clearAllData()" class="w-full py-2 bg-emerald-900 hover:bg-rose-900/60 text-emerald-200 hover:text-rose-200 text-xs font-semibold rounded-lg transition border border-emerald-800">
                    Limpiar Todos los Datos
                </button>
            </div>
        </aside>

        <!-- Main Content Area -->
        <main class="flex-1 p-4 md:p-8 overflow-y-auto">

            <!-- Top Header -->
            <header class="flex flex-col sm:flex-row justify-between items-start sm:items-center mb-8 bg-white p-5 rounded-2xl shadow-sm border border-emerald-100 gap-4 no-print">
                <div>
                    <h2 id="header-title" class="text-xl font-extrabold text-emerald-950">Administración de Trabajadores</h2>
                    <p class="text-xs text-slate-500">Gestión de personal, registros y control de vigencias institucionales CFE.</p>
                </div>
                <div class="flex items-center space-x-3">
                    <div class="bg-emerald-50 border border-emerald-200 text-emerald-800 px-3 py-1.5 rounded-xl text-xs font-bold flex items-center space-x-1.5">
                        <i class="fa-solid fa-database text-emerald-600"></i>
                        <span id="stat-total">0</span><span>Registros</span>
                    </div>
                </div>
            </header>

            <!-- CONTAINER VIEWS -->
            <div id="views-container">

                <!-- VIEW 1: TRABAJADORES (CRUD) -->
                <section id="view-trabajadores" class="space-y-6">
                    <div class="bg-white p-5 rounded-2xl shadow-sm border border-emerald-100 flex flex-col md:flex-row justify-between items-center gap-4">
                        <div class="flex flex-col sm:flex-row gap-3 w-full md:w-auto flex-1">
                            <div class="relative flex-1 max-w-md">
                                <i class="fa-solid fa-magnifying-glass absolute left-3.5 top-3 text-emerald-500 text-xs"></i>
                                <input type="text" id="search-input" onkeyup="renderTable()" placeholder="Buscar por nombre, CURP, teléfono, tarjeta o área..." class="w-full pl-9 pr-4 py-2 bg-emerald-50/50 border border-emerald-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-emerald-600">
                            </div>
                            <select id="filter-status" onchange="renderTable()" class="bg-emerald-50/50 border border-emerald-200 rounded-xl px-3 py-2 text-sm text-emerald-900 focus:outline-none focus:ring-2 focus:ring-emerald-600">
                                <option value="todos">Todos los estados</option>
                                <option value="Vigente">Vigentes</option>
                                <option value="Inactiva">Inactivas</option>
                                <option value="Vencida">Vencidas</option>
                            </select>
                        </div>
                        <button onclick="openModal()" class="w-full md:w-auto bg-emerald-600 hover:bg-emerald-700 text-white font-semibold px-4 py-2.5 rounded-xl text-sm transition shadow-md shadow-emerald-700/20 flex items-center justify-center space-x-2">
                            <i class="fa-solid fa-user-plus"></i>
                            <span>Nuevo Trabajador</span>
                        </button>
                    </div>

                    <!-- Table Data -->
                    <div class="bg-white rounded-2xl shadow-sm border border-emerald-100 overflow-hidden">
                        <div class="overflow-x-auto">
                            <table class="w-full text-left border-collapse">
                                <thead>
                                    <tr class="bg-emerald-900 text-white text-xs uppercase font-bold border-b border-emerald-950">
                                        <th class="p-4">Trabajador</th>
                                        <th class="p-4">Identificación / Teléfono</th>
                                        <th class="p-4">No. / Tarjeta</th>
                                        <th class="p-4">Área / Cargo</th>
                                        <th class="p-4">Vigencia (Inicio - Fin)</th>
                                        <th class="p-4">Estado</th>
                                        <th class="p-4 text-center">Acciones</th>
                                    </tr>
                                </thead>
                                <tbody id="workers-tbody" class="divide-y divide-emerald-50 text-sm">
                                    <!-- Injected via JS -->
                                </tbody>
                            </table>
                        </div>
                    </div>
                </section>

                <!-- VIEW 2: CREDENCIALES -->
                <section id="view-credenciales" class="hidden space-y-6">
                    <div class="bg-white p-6 rounded-2xl shadow-sm border border-emerald-100 space-y-6">
                        <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4 no-print">
                            <div>
                                <h3 class="text-lg font-bold text-emerald-950">Diseño y Generación de Credenciales CFE</h3>
                                <p class="text-xs text-slate-500">Anverso con Área/Cargo y Reverso con información institucional y QR.</p>
                            </div>
                            <div class="w-full md:w-72">
                                <select id="select-credential-worker" onchange="renderDigitalCard()" class="w-full bg-emerald-50/50 border border-emerald-200 rounded-xl px-3 py-2 text-sm font-semibold text-emerald-900">
                                    <!-- Dynamic options -->
                                </select>
                            </div>
                        </div>

                        <!-- Card Anverso & Reverso Display -->
                        <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 pt-4">
                            
                            <!-- ANVERSO -->
                            <div class="bg-gradient-to-br from-emerald-950 via-emerald-900 to-emerald-800 text-white rounded-3xl p-6 shadow-2xl relative overflow-hidden flex flex-col justify-between h-72 border border-emerald-500/40">
                                <div class="absolute top-4 right-4 text-[10px] bg-white/10 backdrop-blur-md px-3 py-1 rounded-full uppercase tracking-widest font-extrabold text-emerald-200">Anverso</div>
                                <div class="flex items-center space-x-3">
                                    <div class="w-10 h-10 bg-emerald-600 rounded-xl flex items-center justify-center font-black text-sm shadow-inner text-white">CFE</div>
                                    <div>
                                        <h4 class="font-black text-sm tracking-wide">COMISIÓN FEDERAL DE ELECTRICIDAD</h4>
                                        <p class="text-[10px] text-emerald-200">Credencial Oficial de Identificación</p>
                                    </div>
                                </div>
                                <div class="flex items-center space-x-5">
                                    <div class="relative">
                                        <img id="card-front-photo" src="" class="w-24 h-32 object-cover rounded-2xl border-2 border-white/30 shadow-lg bg-emerald-950">
                                        <span id="card-front-badge" class="absolute -bottom-2 left-1/2 -translate-x-1/2 text-[9px] font-bold px-2.5 py-0.5 rounded-full uppercase shadow">Vigente</span>
                                    </div>
                                    <div class="space-y-1.5">
                                        <div>
                                            <span class="text-[9px] uppercase font-bold text-emerald-300 tracking-wider block">Trabajador</span>
                                            <strong id="card-front-name" class="text-sm font-extrabold leading-tight block">--</strong>
                                        </div>
                                        <div>
                                            <span class="text-[9px] uppercase font-bold text-emerald-300 tracking-wider block">Número</span>
                                            <strong id="card-front-num" class="text-xs font-mono bg-white/10 px-2 py-0.5 rounded">--</strong>
                                        </div>
                                        <div>
                                            <span class="text-[9px] uppercase font-bold text-emerald-300 tracking-wider block">Área y Cargo</span>
                                            <strong id="card-front-areacargo" class="text-xs text-emerald-100 block">--</strong>
                                        </div>
                                    </div>
                                </div>
                                <div class="flex justify-between items-center text-[10px] text-emerald-300 border-t border-white/10 pt-2">
                                    <span>Documento de Identidad Válido</span>
                                    <span>Firma Autorizada CFE</span>
                                </div>
                            </div>

                            <!-- REVERSO -->
                            <div class="bg-slate-900 text-white rounded-3xl p-6 shadow-2xl relative overflow-hidden flex flex-col justify-between h-72 border border-emerald-900">
                                <div class="absolute top-4 right-4 text-[10px] bg-white/10 backdrop-blur-md px-3 py-1 rounded-full uppercase tracking-widest font-extrabold text-emerald-300">Reverso</div>
                                <div class="grid grid-cols-3 gap-4 items-center">
                                    <div class="col-span-2 space-y-2 text-xs">
                                        <div>
                                            <span class="text-[10px] text-emerald-400 uppercase font-bold block">Información Institucional</span>
                                            <p class="text-[11px] text-slate-300 leading-tight">Sistema Central de Identificación Institucional y Control de Accesos CFE.</p>
                                        </div>
                                        <div class="grid grid-cols-2 gap-2 pt-1 border-t border-slate-800">
                                            <div>
                                                <span class="text-[9px] text-slate-400 uppercase font-bold block">No. Tarjeta</span>
                                                <strong id="card-back-cardnum" class="font-mono text-xs text-emerald-400">--</strong>
                                            </div>
                                            <div>
                                                <span class="text-[9px] text-slate-400 uppercase font-bold block">Vigencia</span>
                                                <strong id="card-back-vigencia" class="text-xs text-emerald-300">--</strong>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="flex flex-col items-center justify-center bg-white p-2.5 rounded-2xl shadow-md">
                                        <div id="card-qr-container" class="w-20 h-20 flex items-center justify-center"></div>
                                        <span class="text-[8px] font-black text-emerald-950 mt-1 uppercase tracking-tighter">QR CFE</span>
                                    </div>
                                </div>
                                <p class="text-[9px] text-slate-400 text-center border-t border-slate-800 pt-2 leading-tight">En caso de pérdida o emergencia, favor de reportar inmediatamente a Recursos Humanos CFE.</p>
                            </div>

                        </div>

                        <!-- Print Action -->
                        <div class="flex justify-end pt-4 no-print">
                            <button onclick="window.print()" class="bg-emerald-700 hover:bg-emerald-800 text-white font-bold px-6 py-2.5 rounded-xl text-sm transition shadow-lg shadow-emerald-900/30 flex items-center space-x-2">
                                <i class="fa-solid fa-print"></i>
                                <span>Imprimir Credencial (Anverso y Reverso)</span>
                            </button>
                        </div>
                    </div>
                </section>

                <!-- VIEW 3: ESCANER / CONSULTA PÚBLICA -->
                <section id="view-escaner" class="hidden space-y-6">
                    <div class="max-w-xl mx-auto bg-white rounded-3xl shadow-sm border border-emerald-100 p-6 sm:p-8 space-y-6">
                        <div class="text-center space-y-1">
                            <div class="w-12 h-12 bg-emerald-50 text-emerald-700 rounded-2xl flex items-center justify-center mx-auto mb-3 shadow-inner border border-emerald-200">
                                <i class="fa-solid fa-qrcode text-xl"></i>
                            </div>
                            <h3 class="text-xl font-extrabold text-emerald-950">Simulador de Escáner QR (Consulta Pública)</h3>
                            <p class="text-xs text-slate-500">Verificación pública de validez institucional CFE.</p>
                        </div>

                        <div>
                            <label class="block text-xs font-bold text-emerald-900 uppercase mb-1">Seleccionar Código QR de Trabajador:</label>
                            <select id="select-qr-sim" onchange="simulateQRScan()" class="w-full bg-emerald-50/50 border border-emerald-200 rounded-xl px-4 py-2.5 text-sm font-semibold text-emerald-900 focus:outline-none focus:ring-2 focus:ring-emerald-600">
                                <!-- Dynamic options -->
                            </select>
                        </div>

                        <!-- QR Public View Result Card -->
                        <div id="qr-result-card" class="bg-slate-50 border border-slate-200 rounded-2xl overflow-hidden shadow-inner">
                            <!-- Injected by JS -->
                        </div>
                    </div>
                </section>

                <!-- VIEW 4: NOTIFICACIONES AUTOMÁTICAS -->
                <section id="view-notificaciones" class="hidden space-y-6">
                    <div class="bg-white p-6 rounded-2xl shadow-sm border border-emerald-100 space-y-6">
                        <div>
                            <h3 class="text-lg font-bold text-emerald-950">Registro de Envío de Correos Electrónicos</h3>
                            <p class="text-xs text-slate-500">Historial y estado de los correos transmitidos automáticamente vía Formspree.</p>
                        </div>

                        <div class="overflow-x-auto border border-emerald-100 rounded-xl">
                            <table class="w-full text-left border-collapse">
                                <thead>
                                    <tr class="bg-emerald-900 text-white text-xs uppercase font-bold border-b border-emerald-950">
                                        <th class="p-3">Trabajador</th>
                                        <th class="p-3">No. Trabajador / Tarjeta</th>
                                        <th class="p-3">Tipo de Notificación</th>
                                        <th class="p-3">Vigencia</th>
                                        <th class="p-3">Estado Actualizado</th>
                                        <th class="p-3">Correo Destino</th>
                                    </tr>
                                </thead>
                                <tbody id="notifications-tbody" class="divide-y divide-emerald-50 text-sm">
                                    <!-- Dynamic notifications log -->
                                </tbody>
                            </table>
                        </div>
                    </div>
                </section>

                <!-- VIEW 5: REPORTES -->
                <section id="view-reportes" class="hidden space-y-6">
                    <div class="bg-white p-6 rounded-2xl shadow-sm border border-emerald-100 space-y-6">
                        <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4 no-print">
                            <div>
                                <h3 class="text-lg font-bold text-emerald-950">Reportes de Credencialización CFE</h3>
                                <p class="text-xs text-slate-500">Consulta general, filtrado por área de adscripción y estado de credenciales.</p>
                            </div>
                            <button onclick="window.print()" class="bg-emerald-900 hover:bg-emerald-950 text-white font-semibold px-4 py-2.5 rounded-xl text-sm transition flex items-center space-x-2 shadow-md">
                                <i class="fa-solid fa-file-pdf"></i>
                                <span>Exportar / Imprimir Reporte</span>
                            </button>
                        </div>

                        <!-- Metrics Summary Cards -->
                        <div class="grid grid-cols-1 sm:grid-cols-4 gap-4">
                            <div class="bg-emerald-50/60 border border-emerald-200 p-4 rounded-2xl">
                                <p class="text-[10px] font-bold text-emerald-700 uppercase tracking-wider">Total Personal</p>
                                <p id="stat-total-card" class="text-2xl font-black text-emerald-950 mt-1">0</p>
                            </div>
                            <div class="bg-emerald-100/70 border border-emerald-300 p-4 rounded-2xl">
                                <p class="text-[10px] font-bold text-emerald-800 uppercase tracking-wider">Vigentes</p>
                                <p id="stat-vigentes-card" class="text-2xl font-black text-emerald-900 mt-1">0</p>
                            </div>
                            <div class="bg-amber-50 border border-amber-200 p-4 rounded-2xl">
                                <p class="text-[10px] font-bold text-amber-600 uppercase tracking-wider">Inactivas</p>
                                <p id="stat-inactivos-card" class="text-2xl font-black text-amber-800 mt-1">0</p>
                            </div>
                            <div class="bg-rose-50 border border-rose-200 p-4 rounded-2xl">
                                <p class="text-[10px] font-bold text-rose-600 uppercase tracking-wider">Vencidas</p>
                                <p id="stat-vencidos-card" class="text-2xl font-black text-rose-800 mt-1">0</p>
                            </div>
                        </div>

                        <!-- Filters for Report -->
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 no-print">
                            <div>
                                <label class="block text-xs font-semibold text-emerald-900 uppercase mb-1">Filtrar por Área de Adscripción:</label>
                                <select id="report-filter-area" onchange="renderReport()" class="w-full bg-emerald-50/50 border border-emerald-200 rounded-xl px-3 py-2 text-sm text-emerald-900">
                                    <option value="todas">Todas las áreas</option>
                                </select>
                            </div>
                            <div>
                                <label class="block text-xs font-semibold text-emerald-900 uppercase mb-1">Filtrar por Estado de Credencial:</label>
                                <select id="report-filter-status" onchange="renderReport()" class="w-full bg-emerald-50/50 border border-emerald-200 rounded-xl px-3 py-2 text-sm text-emerald-900">
                                    <option value="todos">Todos los estados</option>
                                    <option value="Vigente">Vigentes</option>
                                    <option value="Inactiva">Inactivas</option>
                                    <option value="Vencida">Vencidas</option>
                                </select>
                            </div>
                        </div>

                        <!-- Report Table -->
                        <div class="overflow-x-auto border border-emerald-100 rounded-xl">
                            <table class="w-full text-left border-collapse">
                                <thead>
                                    <tr class="bg-emerald-900 text-white text-xs uppercase font-bold border-b border-emerald-950">
                                        <th class="p-3">Trabajador</th>
                                        <th class="p-3">Núm. Tarjeta</th>
                                        <th class="p-3">Área de Adscripción</th>
                                        <th class="p-3">Cargo</th>
                                        <th class="p-3">Vigencia</th>
                                        <th class="p-3">Estado</th>
                                    </tr>
                                </thead>
                                <tbody id="report-tbody" class="divide-y divide-emerald-50 text-sm">
                                    <!-- Dynamic rows loaded here -->
                                </tbody>
                            </table>
                        </div>
                    </div>
                </section>

            </div>
        </main>
    </div>

    <!-- MODAL: REGISTRAR / EDITAR TRABAJADOR -->
    <div id="worker-modal" class="fixed inset-0 bg-emerald-950/70 backdrop-blur-sm hidden flex items-center justify-center p-4 z-50 overflow-y-auto no-print">
        <div class="bg-white rounded-3xl max-w-2xl w-full p-6 sm:p-8 shadow-2xl border border-emerald-100 my-8 space-y-6">
            
            <div class="flex justify-between items-center border-b border-emerald-100 pb-4">
                <div>
                    <h3 id="modal-title" class="text-xl font-bold text-emerald-950">Registrar Nuevo Trabajador</h3>
                    <p class="text-xs text-slate-500">Ingresa los datos del trabajador CFE (Administración Autorizada).</p>
                </div>
                <button onclick="closeModal()" class="w-8 h-8 rounded-full bg-emerald-50 hover:bg-emerald-100 text-emerald-700 flex items-center justify-center transition">
                    <i class="fa-solid fa-xmark"></i>
                </button>
            </div>

            <form id="worker-form" onsubmit="saveWorker(event)" class="space-y-4">
                <input type="hidden" id="field-id">

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <div>
                        <label class="block text-xs font-bold text-emerald-900 uppercase mb-1">Nombre Completo *</label>
                        <input type="text" id="field-nombre" required placeholder="Ej. Ana López Pérez" class="w-full px-3.5 py-2.5 bg-emerald-50/50 border border-emerald-200 rounded-xl text-sm focus:ring-2 focus:ring-emerald-600 focus:bg-white">
                    </div>
                    <div>
                        <label class="block text-xs font-bold text-emerald-900 uppercase mb-1">CURP *</label>
                        <input type="text" id="field-curp" required placeholder="18 Caracteres" class="w-full px-3.5 py-2.5 bg-emerald-50/50 border border-emerald-200 rounded-xl text-sm uppercase focus:ring-2 focus:ring-emerald-600 focus:bg-white">
                    </div>
                </div>

                <div class="grid grid-cols-3 gap-4">
                    <div>
                        <label class="block text-xs font-bold text-emerald-900 uppercase mb-1">Edad *</label>
                        <input type="number" id="field-edad" min="18" max="90" required placeholder="Ej. 28" class="w-full px-3.5 py-2.5 bg-emerald-50/50 border border-emerald-200 rounded-xl text-sm focus:ring-2 focus:ring-emerald-600 focus:bg-white">
                    </div>
                    <div>
                        <label class="block text-xs font-bold text-emerald-900 uppercase mb-1">Sexo *</label>
                        <select id="field-sexo" class="w-full px-3.5 py-2.5 bg-emerald-50/50 border border-emerald-200 rounded-xl text-sm focus:ring-2 focus:ring-emerald-600 text-emerald-900">
                            <option value="Femenino">Femenino</option>
                            <option value="Masculino">Masculino</option>
                        </select>
                    </div>
                    <div>
                        <label class="block text-xs font-bold text-emerald-900 uppercase mb-1">Número de Teléfono *</label>
                        <input type="tel" id="field-telefono" required placeholder="Ej. 961 123 4567" class="w-full px-3.5 py-2.5 bg-emerald-50/50 border border-emerald-200 rounded-xl text-sm focus:ring-2 focus:ring-emerald-600">
