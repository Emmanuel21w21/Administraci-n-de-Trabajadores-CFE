                        <input type="date" id="field-vigencia" required class="w-full px-3.5 py-2.5 bg-emerald-50/50 border border-emerald-200 rounded-xl text-sm focus:ring-2 focus:ring-emerald-600">
                    </div>
                    <div>
                        <label class="block text-xs font-bold text-emerald-900 uppercase mb-1">Estado Credencial</label>
                        <select id="field-estado" class="w-full px-3.5 py-2.5 bg-emerald-50/50 border border-emerald-200 rounded-xl text-sm focus:ring-2 focus:ring-emerald-600 text-emerald-900">
                            <option value="Vigente">Vigente</option>
                            <option value="Inactiva">Inactiva</option>
                            <option value="Vencida">Vencida</option>
                        </select>
