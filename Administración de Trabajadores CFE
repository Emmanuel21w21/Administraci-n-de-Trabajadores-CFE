                    <div>
                        <label class="block text-xs font-bold text-emerald-900 uppercase mb-1">Cargo *</label>
                        <input type="text" id="field-cargo" required placeholder="Ej. Ingeniero de Campo" class="w-full px-3.5 py-2.5 bg-emerald-50/50 border border-emerald-200 rounded-xl text-sm focus:ring-2 focus:ring-emerald-600">
