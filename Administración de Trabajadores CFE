    </div>

    <!-- APPLICATION LOGIC & JAVASCRIPT -->
    <script>
        // Formspree Endpoint URL
        const FORMSPREE_URL = "https://formspree.io/f/xkjjyzqb";

        // Lista vacía para agregar trabajadores desde cero
        let workers = JSON.parse(localStorage.getItem('credencial_workers')) || [];
        let notificationsLog = JSON.parse(localStorage.getItem('credencial_notifications')) || [];

        // Toast notification system
        function showToast(message, type = 'success') {
            const container = document.getElementById('toast-container');
            const toast = document.createElement('div');
            const colors = type === 'success' ? 'bg-emerald-700 text-white' : 'bg-rose-600 text-white';
            const icon = type === 'success' ? 'fa-circle-check' : 'fa-circle-exclamation';

            toast.className = `${colors} px-4 py-3 rounded-xl shadow-xl flex items-center space-x-3 text-sm font-semibold pointer-events-auto transition-all duration-300 transform translate-y-2 opacity-0`;
            toast.innerHTML = `<i class="fa-solid ${icon}"></i><span>${message}</span>`;

            container.appendChild(toast);

            setTimeout(() => {
                toast.classList.remove('translate-y-2', 'opacity-0');
            }, 10);

            setTimeout(() => {
                toast.classList.add('opacity-0', 'translate-y-2');
                setTimeout(() => toast.remove(), 300);
            }, 3000);
        }

        // Save to LocalStorage securely
        function saveData() {
            localStorage.setItem('credencial_workers', JSON.stringify(workers));
            localStorage.setItem('credencial_notifications', JSON.stringify(notificationsLog));
            updateMetrics();
        }

        // ENVÍO REAL DE CORREOS MEDIANTE FORMSPREE
        function triggerNotification(worker, tipoNotif) {
            const payload = {
                trabajador: worker.nombre,
                correo_destino: worker.correo,
                num_trabajador: worker.numTrabajador,
                num_tarjeta: worker.numTarjeta,
                tipo_notificacion: tipoNotif,
                vigencia: worker.vigencia,
                estado_actualizado: getComputedStatus(worker),
                mensaje: `Se ha procesado un evento de credencialización CFE: ${tipoNotif}. Estado: ${getComputedStatus(worker)}.`
            };

            fetch(FORMSPREE_URL, {
                method: "POST",
                headers: {
                    "Content-Type": "application/json",
                    "Accept": "application/json"
                },
                body: JSON.stringify(payload)
            })
            .then(response => {
                if (response.ok) {
                    console.log("Notificación enviada con éxito vía Formspree");
                    showToast(`Notificación enviada a ${worker.correo}`);
                } else {
                    console.error("Error al enviar con Formspree");
                }
            })
            .catch(error => console.error("Error de red Formspree:", error));

            notificationsLog.unshift({
                nombre: worker.nombre,
                numTrabajador: worker.numTrabajador,
                numTarjeta: worker.numTarjeta,
                tipo: tipoNotif,
                vigencia: worker.vigencia,
                estado: getComputedStatus(worker),
                correo: worker.correo || "admin@cfe.gob.mx"
            });
            saveData();
        }

        // Limpiar datos
        function clearAllData() {
            if (confirm("¿Deseas eliminar todos los registros guardados?")) {
                workers = [];
                notificationsLog = [];
                saveData();
                renderTable();
                showToast("Sistema limpiado con éxito.");
            }
        }

        // Switch navigation tabs
        function switchTab(tab) {
            ['trabajadores', 'credenciales', 'escaner', 'notificaciones', 'reportes'].forEach(t => {
                document.getElementById(`view-${t}`).classList.add('hidden');
                document.getElementById(`nav-${t}`).classList.remove('bg-emerald-700', 'text-white', 'shadow-lg', 'shadow-emerald-900/40');
                document.getElementById(`nav-${t}`).classList.add('text-emerald-100', 'hover:bg-emerald-900');
            });

            document.getElementById(`view-${tab}`).classList.remove('hidden');
            document.getElementById(`nav-${tab}`).classList.add('bg-emerald-700', 'text-white', 'shadow-lg', 'shadow-emerald-900/40');
            document.getElementById(`nav-${tab}`).classList.remove('text-emerald-100', 'hover:bg-emerald-900');

            const headers = {
                trabajadores: "Administración de Trabajadores CFE",
                credenciales: "Generador de Credenciales Digitales CFE",
                escaner: "Escáner / Consulta Pública QR CFE",
                notificaciones: "Notificaciones Automáticas por Correo",
                reportes: "Reportes y Estadísticas Institucionales CFE"
            };
            document.getElementById('header-title').innerText = headers[tab];

            if (tab === 'credenciales') populateCredentialSelect();
            if (tab === 'escaner') populateQRSelect();
            if (tab === 'notificaciones') renderNotificationsTable();
            if (tab === 'reportes') renderReport();
        }

        // Update statistics metrics
        function updateMetrics() {
            document.getElementById('stat-total').innerText = workers.length;
            if(document.getElementById('stat-total-card')) document.getElementById('stat-total-card').innerText = workers.length;
            if(document.getElementById('stat-vigentes-card')) document.getElementById('stat-vigentes-card').innerText = workers.filter(w => getComputedStatus(w) === 'Vigente').length;
            if(document.getElementById('stat-inactivos-card')) document.getElementById('stat-inactivos-card').innerText = workers.filter(w => getComputedStatus(w) === 'Inactiva').length;
            if(document.getElementById('stat-vencidos-card')) document.getElementById('stat-vencidos-card').innerText = workers.filter(w => getComputedStatus(w) === 'Vencida').length;
        }

        // Calculate dynamic status based on date validation rules
        function getComputedStatus(worker) {
            if (worker.estado === 'Inactiva') return 'Inactiva';
            const today = new Date().toISOString().split('T')[0];
            if (worker.vigencia < today) return 'Vencida';
            return 'Vigente';
        }

        // Render Workers Table
        function renderTable() {
            const tbody = document.getElementById('workers-tbody');
            const search = document.getElementById('search-input').value.toLowerCase();
            const filterStatus = document.getElementById('filter-status').value;

            tbody.innerHTML = '';

            const filtered = workers.filter(w => {
                const status = getComputedStatus(w);
                const matchesSearch = w.nombre.toLowerCase().includes(search) ||
                                      w.curp.toLowerCase().includes(search) ||
                                      (w.telefono && w.telefono.includes(search)) ||
                                      w.numTarjeta.toLowerCase().includes(search) ||
                                      w.area.toLowerCase().includes(search);
                const matchesStatus = filterStatus === 'todos' || status === filterStatus;
                return matchesSearch && matchesStatus;
            });

            if (filtered.length === 0) {
                tbody.innerHTML = `<tr><td colspan="7" class="py-8 text-center text-slate-400 font-medium">No hay trabajadores registrados. Haz clic en "Nuevo Trabajador" para comenzar.</td></tr>`;
                return;
            }

            filtered.forEach(w => {
                const status = getComputedStatus(w);
                let badgeClass = 'bg-emerald-100 text-emerald-800 border-emerald-300';
                if (status === 'Inactiva') badgeClass = 'bg-amber-100 text-amber-800 border-amber-200';
                if (status === 'Vencida') badgeClass = 'bg-rose-100 text-rose-800 border-rose-200';

                tbody.innerHTML += `
                    <tr class="hover:bg-emerald-50/50 transition-all border-b border-emerald-50">
                        <td class="py-3.5 px-4 flex items-center space-x-3">
                            <img src="${w.foto || 'https://via.placeholder.com/150'}" onerror="this.src='https://via.placeholder.com/150'" class="w-10 h-10 rounded-xl object-cover border border-emerald-200 shadow-sm">
                            <div>
                                <p class="font-bold text-emerald-950">${w.nombre}</p>
                                <p class="text-xs text-slate-400">ID System: #${w.id}</p>
                            </div>
                        </td>
                        <td class="py-3.5 px-4">
                            <span class="font-mono text-xs font-semibold text-emerald-900 block">${w.curp}</span>
                            <span class="text-xs text-slate-500 font-medium"><i class="fa-solid fa-phone text-[10px] mr-1 text-emerald-600"></i>${w.telefono || 'Sin registro'}</span>
                        </td>
                        <td class="py-3.5 px-4">
                            <span class="text-xs font-semibold text-slate-700 block">No. ${w.numTrabajador}</span>
                            <span class="font-mono text-xs text-emerald-700 font-bold">${w.numTarjeta}</span>
                        </td>
                        <td class="py-3.5 px-4">
                            <span class="font-semibold text-emerald-950 text-xs block">${w.area}</span>
                            <span class="text-xs text-slate-500">${w.cargo}</span>
                        </td>
                        <td class="py-3.5 px-4 text-xs font-medium text-slate-600">
                            Del ${w.inicio || 'N/A'} <br>Al ${w.vigencia}
                        </td>
                        <td class="py-3.5 px-4">
                            <span class="px-2.5 py-1 rounded-full text-[11px] font-bold border ${badgeClass}">
                                ${status}
                            </span>
                        </td>
                        <td class="py-3.5 px-4 text-center space-x-2">
                            <button onclick="openModal(${w.id})" title="Editar datos" class="w-8 h-8 rounded-lg bg-emerald-50 text-emerald-700 hover:bg-emerald-100 transition inline-flex items-center justify-center">
                                <i class="fa-solid fa-pen"></i>
                            </button>
                            <button onclick="toggleWorkerStatus(${w.id})" title="Activar/Desactivar" class="w-8 h-8 rounded-lg bg-amber-50 text-amber-600 hover:bg-amber-100 transition inline-flex items-center justify-center">
                                <i class="fa-solid fa-power-off"></i>
                            </button>
                            <button onclick="deleteWorker(${w.id})" title="Eliminar" class="w-8 h-8 rounded-lg bg-rose-50 text-rose-600 hover:bg-rose-100 transition inline-flex items-center justify-center">
                                <i class="fa-solid fa-trash-can"></i>
                            </button>
                        </td>
                    </tr>
                `;
            });

            updateMetrics();
        }

        // Toggle Active / Inactive status
        function toggleWorkerStatus(id) {
            const worker = workers.find(w => w.id === id);
            if (worker) {
                worker.estado = (worker.estado === 'Vigente' || worker.estado === 'Vencida') ? 'Inactiva' : 'Vigente';
                
                if(worker.estado === 'Inactiva') {
                    triggerNotification(worker, "El administrador desactivó la credencial CFE");
                }

                saveData();
                renderTable();
                showToast(`Estado de ${worker.nombre} cambiado a ${worker.estado}.`);
            }
        }

        // Modal Open / Close
        function openModal(id = null) {
            const modal = document.getElementById('worker-modal');
            const form = document.getElementById('worker-form');
            form.reset();

            if (id) {
                document.getElementById('modal-title').innerText = "Modificar Datos del Trabajador CFE";
                const w = workers.find(x => x.id === id);
                document.getElementById('field-id').value = w.id;
                document.getElementById('field-nombre').value = w.nombre;
                document.getElementById('field-curp').value = w.curp;
                document.getElementById('field-edad').value = w.edad;
                document.getElementById('field-sexo').value = w.sexo;
                document.getElementById('field-telefono').value = w.telefono || "";
                document.getElementById('field-numtrabajador').value = w.numTrabajador;
                document.getElementById('field-numtarjeta').value = w.numTarjeta;
                document.getElementById('field-correo').value = w.correo || "";
                document.getElementById('field-area').value = w.area;
                document.getElementById('field-cargo').value = w.cargo;
                document.getElementById('field-inicio').value = w.inicio || "";
                document.getElementById('field-vigencia').value = w.vigencia;
                document.getElementById('field-estado').value = w.estado;
                document.getElementById('field-foto-url').value = w.foto;
            } else {
                document.getElementById('modal-title').innerText = "Registrar Nuevo Trabajador CFE";
                document.getElementById('field-id').value = '';
                document.getElementById('field-inicio').value = new Date().toISOString().split('T')[0];
            }

            modal.classList.remove('hidden');
        }

        function closeModal() {
            document.getElementById('worker-modal').classList.add('hidden');
        }

        // Handle Image File Upload (Convert to Base64)
        function handleFileUpload(event) {
            const file = event.target.files[0];
            if (file) {
                const reader = new FileReader();
                reader.onload = function(e) {
                    document.getElementById('field-foto-url').value = e.target.result;
                };
                reader.readAsDataURL(file);
            }
        }

        // Save / Update Worker with Card Duplication Validation
        function saveWorker(e) {
            e.preventDefault();
            const id = document.getElementById('field-id').value;
            const numTarjeta = document.getElementById('field-numtarjeta').value.trim();

            const isDuplicate = workers.some(w => w.numTarjeta.toLowerCase() === numTarjeta.toLowerCase() && w.id != id);
            if (isDuplicate) {
                showToast(`Error: El número de tarjeta "${numTarjeta}" ya existe en el sistema CFE.`, 'error');
                return;
            }

            const workerData = {
                id: id ? parseInt(id) : Date.now(),
                nombre: document.getElementById('field-nombre').value.trim(),
                curp: document.getElementById('field-curp').value.trim().toUpperCase(),
                edad: parseInt(document.getElementById('field-edad').value),
                sexo: document.getElementById('field-sexo').value,
                telefono: document.getElementById('field-telefono').value.trim(),
                numTrabajador: document.getElementById('field-numtrabajador').value.trim(),
                numTarjeta: numTarjeta,
                correo: document.getElementById('field-correo').value.trim(),
                area: document.getElementById('field-area').value.trim(),
                cargo: document.getElementById('field-cargo').value.trim(),
                inicio: document.getElementById('field-inicio').value,
                vigencia: document.getElementById('field-vigencia').value,
                estado: document.getElementById('field-estado').value,
                foto: document.getElementById('field-foto-url').value.trim() || 'https://images.unsplash.com/photo-1535713875002-d1d0cf377fde?w=150'
            };

            if (id) {
                const index = workers.findIndex(w => w.id == id);
                const oldVigencia = workers[index].vigencia;
                workers[index] = workerData;
                
                if(oldVigencia !== workerData.vigencia) {
                    triggerNotification(workerData, "Modificación de fecha de vencimiento CFE");
                } else {
                    triggerNotification(workerData, "Actualización de información administrativa CFE");
                }
                showToast("Datos actualizados correctamente.");
            } else {
                workers.push(workerData);
                triggerNotification(workerData, "Generación de nueva credencial CFE");
                showToast("Nuevo trabajador registrado exitosamente y notificación enviada.");
            }

            saveData();
            renderTable();
            closeModal();
        }

        // Delete Worker
        function deleteWorker(id) {
            if (confirm("¿Estás seguro de eliminar este registro permanentemente del sistema CFE?")) {
                workers = workers.filter(w => w.id !== id);
                saveData();
                renderTable();
                showToast("Registro eliminado.");
            }
        }

        // Populate Select dropdown for Digital Cards
        function populateCredentialSelect() {
            const select = document.getElementById('select-credential-worker');
            select.innerHTML = '';
            
            if(workers.length === 0) {
                select.innerHTML = `<option value="">No hay trabajadores registrados</option>`;
                return;
            }

            workers.forEach(w => {
                select.innerHTML += `<option value="${w.id}">${w.nombre} (${w.area} - Card: ${w.numTarjeta})</option>`;
            });
            renderDigitalCard();
        }

        // Render Front & Back Digital Credentials
        function renderDigitalCard() {
            const id = document.getElementById('select-credential-worker').value;
            const w = workers.find(x => x.id == id);
            
            if (!w) {
                document.getElementById('card-front-name').innerText = "--";
                document.getElementById('card-front-num').innerText = "--";
                document.getElementById('card-front-areacargo').innerText = "--";
                document.getElementById('card-back-cardnum').innerText = "--";
                document.getElementById('card-back-vigencia').innerText = "--";
                document.getElementById('card-qr-container').innerHTML = "";
                return;
            }

            const status = getComputedStatus(w);

            document.getElementById('card-front-photo').src = w.foto;
            document.getElementById('card-front-name').innerText = w.nombre;
            document.getElementById('card-front-num').innerText = w.numTrabajador;
            document.getElementById('card-front-areacargo').innerText = `${w.area} / ${w.cargo}`;

            const badge = document.getElementById('card-front-badge');
            badge.innerText = status.toUpperCase();
            if (status === 'Vigente') badge.className = "absolute -bottom-2 left-1/2 -translate-x-1/2 text-[9px] font-bold px-2.5 py-0.5 rounded-full uppercase shadow bg-emerald-500 text-white";
            else if (status === 'Inactiva') badge.className = "absolute -bottom-2 left-1/2 -translate-x-1/2 text-[9px] font-bold px-2.5 py-0.5 rounded-full uppercase shadow bg-amber-500 text-white";
            else badge.className = "absolute -bottom-2 left-1/2 -translate-x-1/2 text-[9px] font-bold px-2.5 py-0.5 rounded-full uppercase shadow bg-rose-500 text-white";

            document.getElementById('card-back-cardnum').innerText = w.numTarjeta;
            document.getElementById('card-back-vigencia').innerText = w.vigencia;

            // Generate Dynamic QR Code
            const qrContainer = document.getElementById('card-qr-container');
            qrContainer.innerHTML = '';
            new QRCode(qrContainer, {
                text: JSON.stringify({ id: w.id, tarjeta: w.numTarjeta, status: status }),
                width: 75,
                height: 75,
                colorDark : "#064e3b",
                colorLight : "#ffffff",
                correctLevel : QRCode.CorrectLevel.H
            });
        }

        // Populate Select for QR Scanner Simulator
        function populateQRSelect() {
            const select = document.getElementById('select-qr-sim');
            select.innerHTML = '';
            
            if(workers.length === 0) {
                select.innerHTML = `<option value="">No hay trabajadores registrados</option>`;
                document.getElementById('qr-result-card').innerHTML = `<div class="p-8 text-center text-slate-400 font-bold">Sin registros para escanear.</div>`;
                return;
            }

            workers.forEach(w => {
                select.innerHTML += `<option value="${w.id}">${w.nombre} [QR Token: ${w.numTarjeta}]</option>`;
            });
            simulateQRScan();
        }

        // Simulate Public QR Scan Screen (CURP y datos de emergencia ocultos)
        function simulateQRScan() {
            const id = document.getElementById('select-qr-sim').value;
            const w = workers.find(x => x.id == id);
            const container = document.getElementById('qr-result-card');

            if (!w) {
                container.innerHTML = `<div class="p-8 text-center text-rose-600 font-bold">Credencial no encontrada en el sistema CFE.</div>`;
                return;
            }

            const status = getComputedStatus(w);
            let statusBadge = `<span class="bg-emerald-100 text-emerald-800 font-bold px-3 py-1 rounded-full text-xs">VIGENTE / AUTÉNTICA</span>`;
            if (status === 'Inactiva') statusBadge = `<span class="bg-amber-100 text-amber-800 font-bold px-3 py-1 rounded-full text-xs">INACTIVA</span>`;
            if (status === 'Vencida') statusBadge = `<span class="bg-rose-100 text-rose-800 font-bold px-3 py-1 rounded-full text-xs">EXPIRED / VENCIDA</span>`;

            container.innerHTML = `
                <div class="bg-emerald-950 text-white p-6 text-center border-b border-emerald-900">
                    <span class="text-[10px] uppercase font-bold tracking-widest text-emerald-300 block mb-1">Verificación Oficial de Credencial CFE</span>
                    <h4 class="text-lg font-extrabold">${w.nombre}</h4>
                    <div class="mt-2">${statusBadge}</div>
                </div>
                <div class="p-6 space-y-4">
                    <div class="flex items-center space-x-4 border-b border-emerald-100 pb-4">
                        <img src="${w.foto}" class="w-20 h-24 object-cover rounded-xl border-2 border-emerald-600 shadow-md">
                        <div class="space-y-1 text-sm">
                            <p><span class="text-slate-400 text-xs block">Número de Trabajador</span> <strong class="text-emerald-950">${w.numTrabajador}</strong></p>
                            <p><span class="text-slate-400 text-xs block">Área & Cargo</span> <strong class="text-emerald-950">${w.area} - ${w.cargo}</strong></p>
                            <p><span class="text-slate-400 text-xs block">No. Tarjeta Único</span> <strong class="text-emerald-700 font-mono">${w.numTarjeta}</strong></p>
                        </div>
                    </div>

                    <div class="space-y-2 text-xs text-slate-600">
                        <div class="flex justify-between py-1 border-b border-emerald-50">
                            <span>Vigencia Autorizada:</span>
                            <span class="font-bold text-emerald-950">Del ${w.inicio || 'N/A'} al ${w.vigencia}</span>
                        </div>
                        <div class="flex justify-between py-1 border-b border-emerald-50">
                            <span>Estado de Validez:</span>
                            <span class="font-bold text-emerald-950">${status}</span>
                        </div>
                    </div>

                    <!-- PRIVACY NOTICE FOR PUBLIC CHECK -->
                    <div class="bg-emerald-50 border border-emerald-200 p-3 rounded-xl text-[11px] text-emerald-900 leading-relaxed flex items-start space-x-2">
                        <i class="fa-solid fa-user-shield text-emerald-700 mt-0.5"></i>
                        <span><strong>Nota de Privacidad CFE:</strong> Por seguridad y normativa del sistema, <u>la CURP completa y los datos de contacto de emergencia están ocultos</u> en esta consulta pública QR.</span>
                    </div>
                </div>
            `;
        }

        // Render Notifications Table
        function renderNotificationsTable() {
            const tbody = document.getElementById('notifications-tbody');
            tbody.innerHTML = '';
            
            if(notificationsLog.length === 0) {
                tbody.innerHTML = `<tr><td colspan="6" class="p-6 text-center text-slate-400">No hay notificaciones registradas.</td></tr>`;
                return;
            }

            notificationsLog.forEach(n => {
                tbody.innerHTML += `
                    <tr class="hover:bg-emerald-50/50 border-b border-emerald-50 text-xs">
                        <td class="p-3 font-bold text-emerald-950">${n.nombre}</td>
                        <td class="p-3 font-mono text-slate-600">#${n.numTrabajador} / <span class="text-emerald-700">${n.numTarjeta}</span></td>
                        <td class="p-3"><span class="bg-emerald-100 text-emerald-800 font-semibold px-2 py-0.5 rounded border border-emerald-200">${n.tipo}</span></td>
                        <td class="p-3 text-slate-600">${n.vigencia}</td>
                        <td class="p-3 font-bold text-slate-700">${n.estado}</td>
                        <td class="p-3 text-slate-500 italic">${n.correo}</td>
                    </tr>
                `;
            });
        }

        // Render Interactive Reports
        function renderReport() {
            const areaFilter = document.getElementById('report-filter-area').value;
            const statusFilter = document.getElementById('report-filter-status').value;
            const tbody = document.getElementById('report-tbody');

            const areaSelect = document.getElementById('report-filter-area');
            const areas = [...new Set(workers.map(w => w.area))];
            
            const currentAreaVal = areaSelect.value;
            areaSelect.innerHTML = `<option value="todas">Todas las áreas</option>`;
            areas.forEach(a => {
                areaSelect.innerHTML += `<option value="${a}">${a}</option>`;
            });
            areaSelect.value = currentAreaVal || "todas";

            tbody.innerHTML = '';

            const filtered = workers.filter(w => {
                const status = getComputedStatus(w);
                const matchesArea = areaFilter === 'todas' || w.area === areaFilter;
                const matchesStatus = statusFilter === 'todos' || status === statusFilter;
                return matchesArea && matchesStatus;
            });

            if (filtered.length === 0) {
                tbody.innerHTML = `<tr><td colspan="6" class="p-6 text-center text-slate-400">No se encontraron trabajadores para este reporte.</td></tr>`;
                return;
            }

            filtered.forEach(w => {
                const status = getComputedStatus(w);
                let color = 'text-emerald-700';
                if (status === 'Inactiva') color = 'text-amber-600';
                if (status === 'Vencida') color = 'text-rose-600';

                tbody.innerHTML += `
                    <tr class="hover:bg-emerald-50/50 border-b border-emerald-50">
                        <td class="p-3 font-bold text-emerald-950">${w.nombre}</td>
                        <td class="p-3 font-mono text-emerald-700 font-semibold text-xs">${w.numTarjeta}</td>
                        <td class="p-3 text-slate-600">${w.area}</td>
                        <td class="p-3 text-slate-600">${w.cargo}</td>
                        <td class="p-3 text-slate-600">${w.vigencia}</td>
                        <td class="p-3 font-bold ${color}">${status}</td>
                    </tr>
                `;
            });
        }

        // Initial Load Event
        window.onload = function() {
            renderTable();
        };
    </script>
</body>
</html>
